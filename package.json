{
  "name": "huishouden",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "icons": "pwa-icons",
    "e2e": "playwright test e2e/smoke.spec.ts",
    "prepare": "git config core.hooksPath .githooks",
    "bootstrap": "node_modules/@huishouden/pwa-kit/infra/bootstrap.sh infra/apps.conf",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "env:pull": "gh variable list --json name,value -q '.[] | select(.name|startswith(\"VITE_\")) | \"\\(.name)=\\(.value)\"' > .env.local && echo 'wrote .env.local'"
  },
  "devDependencies": {
    "@huishouden/pwa-kit": "github:huishouden/pwa-kit#v0.18.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "firebase": "^12"
  }
}
